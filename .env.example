# --- Supabase (public, safe for the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Data mode: "supabase" (default when the two values above are set) or "demo"
# Demo mode runs entirely in the browser with seeded sample publications.
VITE_DATA_MODE=supabase

# Routing: "browser" (clean URLs, needs SPA fallback on your host) or "hash"
VITE_ROUTER=browser

# Branding / limits shown in the UI
VITE_APP_NAME=The Unwritten Pages
VITE_MAX_PDF_MB=50

# NEVER put the service-role key in any VITE_* variable. It belongs only in
# Supabase Edge Function secrets (set automatically as SUPABASE_SERVICE_ROLE_KEY).
